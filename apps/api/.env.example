# Base de datos (PostgreSQL en Docker, puerto 5434 del host)
DATABASE_URL="postgresql://cotizador:cotizador@localhost:5434/cotizador"

# Servidor
PORT=3000
WEB_ORIGIN="http://localhost:5173"
NODE_ENV=development

# Autenticación
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="cambia_esto_por_un_secreto_generado"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
